<Window x:Class="Bledob.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BLEDOB"
        Width="480"
        Height="760"
        MinWidth="420"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Paper}"
        Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI"
        FontSize="14"
        Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="BLEDOB" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="One color for the whole strip, plus the effects built into the controller."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Text="Close the phone app first. The strip accepts one Bluetooth connection."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Text="Closing this window leaves BLEDOB in the tray and releases Bluetooth. Quit from the tray icon."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText" Text="Not connected" TextWrapping="Wrap" Foreground="{StaticResource Accent}" Margin="0,0,0,16"/>

            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ADDRESS" Style="{StaticResource Section}"/>
                    <TextBox x:Name="AddressBox" TextChanged="AddressBox_TextChanged" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ScanButton" Content="Scan" Click="Scan_Click"/>
                        <Button x:Name="ConnectButton" Grid.Column="2" Content="Connect" Style="{StaticResource AccentButton}" Click="Connect_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="NEARBY" Style="{StaticResource Section}"/>
                    <ListBox x:Name="DeviceList" Height="148"
                             MouseDoubleClick="DeviceList_MouseDoubleClick"
                             SelectionChanged="DeviceList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding AddressText}" Foreground="#A39E94" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding RssiText}" Foreground="#A39E94" VerticalAlignment="Center" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <CheckBox x:Name="ShowAllCheck" Content="Show every nearby device" Checked="ShowAllCheck_Changed" Unchecked="ShowAllCheck_Changed"/>
                </StackPanel>
            </Border>

            <Border x:Name="ControlsCard" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12" IsEnabled="False">
                <StackPanel>
                    <TextBlock Text="POWER" Style="{StaticResource Section}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Turn on" Background="#2F6B4F" Click="TurnOn_Click"/>
                        <Button Grid.Column="2" Content="Turn off" Background="#6E3A34" Click="TurnOff_Click"/>
                    </Grid>

                    <DockPanel Margin="0,0,0,8">
                        <Border x:Name="Swatch" DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="8" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"/>
                        <TextBlock Text="COLOR" Style="{StaticResource Section}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Width="36" TextAlignment="Right" Foreground="{StaticResource Muted}"
                                   Text="{Binding Value, ElementName=RedSlider, StringFormat={}{0:0}}"/>
                        <TextBlock DockPanel.Dock="Left" Width="52" Text="Red" Foreground="{StaticResource Muted}"/>
                        <Slider x:Name="RedSlider" Minimum="0" Maximum="255" Value="255" IsMoveToPointEnabled="True" ValueChanged="Color_ValueChanged"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Width="36" TextAlignment="Right" Foreground="{StaticResource Muted}"
                                   Text="{Binding Value, ElementName=GreenSlider, StringFormat={}{0:0}}"/>
                        <TextBlock DockPanel.Dock="Left" Width="52" Text="Green" Foreground="{StaticResource Muted}"/>
                        <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" Value="255" IsMoveToPointEnabled="True" ValueChanged="Color_ValueChanged"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Width="36" TextAlignment="Right" Foreground="{StaticResource Muted}"
                                   Text="{Binding Value, ElementName=BlueSlider, StringFormat={}{0:0}}"/>
                        <TextBlock DockPanel.Dock="Left" Width="52" Text="Blue" Foreground="{StaticResource Muted}"/>
                        <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" Value="255" IsMoveToPointEnabled="True" ValueChanged="Color_ValueChanged"/>
                    </DockPanel>
                    <WrapPanel x:Name="Presets" Margin="0,0,0,14"/>

                    <TextBlock Text="BRIGHTNESS" Style="{StaticResource Section}"/>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Right" Width="36" TextAlignment="Right" Foreground="{StaticResource Muted}"
                                   Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:0}}"/>
                        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="100" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" ValueChanged="Brightness_ValueChanged"/>
                    </DockPanel>

                    <TextBlock Text="EFFECT" Style="{StaticResource Section}"/>
                    <ComboBox x:Name="EffectBox" SelectionChanged="EffectBox_SelectionChanged" Margin="0,0,0,10">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1B1E24"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F2EFE9"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3A3120"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F2EFE9"/>
                        </ComboBox.Resources>
                    </ComboBox>
                    <TextBlock Text="SPEED" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="36" TextAlignment="Right" Foreground="{StaticResource Muted}"
                                   Text="{Binding Value, ElementName=SpeedSlider, StringFormat={}{0:0}}"/>
                        <Slider x:Name="SpeedSlider" Minimum="0" Maximum="100" Value="50" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" ValueChanged="Speed_ValueChanged"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="ACTIVITY" Style="{StaticResource Section}"/>
            <TextBox x:Name="LogBox" Height="88" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </ScrollViewer>
</Window>
