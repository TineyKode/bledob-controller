<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Bledob</AssemblyName>
    <RootNamespace>Bledob.App</RootNamespace>
    <ApplicationTitle>BLEDOB</ApplicationTitle>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bledob.Protocol\Bledob.Protocol.csproj" />
    <ProjectReference Include="..\Bledob.Bluetooth\Bledob.Bluetooth.csproj" />
  </ItemGroup>

</Project>
